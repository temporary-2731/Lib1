<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:padding="24dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="VF Conversion in Progress"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:layout_marginBottom="24dp"/>

    <ProgressBar
        android:id="@+id/progress_main"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:progressTint="@color/blue_accent"
        android:progressBackgroundTint="#333"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:gravity="center">
        <ImageView
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/blue_accent"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:id="@+id/tv_data_transferred"
            android:text="0 MB / 0 MB"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal">
        <TextView android:text="Elapsed: " android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/tv_elapsed" android:text="00:00:00" android:textColor="@color/blue_accent"/>
        <TextView android:text="  Remaining: " android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp"/>
        <TextView android:id="@+id/tv_remaining" android:text="--:--:--" android:textColor="@color/blue_accent"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_percentage"
        android:text="0%"
        android:textColor="?attr/colorOnSurface"
        android:textSize="48sp"
        android:layout_marginTop="24dp"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="32dp">
        <Button
            android:id="@+id/btn_pause_resume"
            android:text="Pause"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/btn_cancel"
            android:text="Cancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
